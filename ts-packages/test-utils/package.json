{
	"name": "@qgis/test-utils",
	"version": "0.1.0",
	"description": "Shared test fixtures for the qgis-rs TypeScript packages",
	"license": "GPL-2.0-or-later",
	"author": "qgis-rs contributors",
	"homepage": "https://archont561.github.io/qgis-rs/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Archont561/qgis-rs"
	},
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bunup",
		"test": "bun test ./tests",
		"typecheck": "tsc --noEmit",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write ."
	},
	"dependencies": {
		"fast-check": "^4.10.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.3.11",
		"bunup": "^0.16.32",
		"typescript": "^5.9.0"
	}
}
