{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// `DOM` is this package's to add, not the base's: the package is a browser bridge and
		// nothing else in the workspace is. `DOM.Iterable` comes with it because the loader
		// walks `channel.objects`.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["bun"],
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	// Tests are typechecked by `tsconfig.test.json` instead of being excluded silently: this
	// package's suite exercises the published surface through `bun test`, and the tests
	// import the source with a `.ts` extension, which `allowImportingTsExtensions` forbids
	// for a project that emits.
	"exclude": ["node_modules", "dist"]
}
