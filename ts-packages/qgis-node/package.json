{
	"name": "@archont561/qgis-node",
	"version": "0.1.0",
	"description": "Node.js / TypeScript bindings and the qgis-cli binary for qgis-rs — native-speed QGIS rendering, tiling, and plugin tools",
	"main": "src/index.js",
	"types": "src/index.d.ts",
	"bin": {
		"qgis-cli": "./bin/qgis-cli.js"
	},
	"scripts": {
		"build": "napi build --platform --release --cargo-cwd ../../crates/qgis-node --js false --dts .napi-generated.d.ts .",
		"build:debug": "napi build --platform --cargo-cwd ../../crates/qgis-node --js false --dts .napi-generated.d.ts .",
		"test": "QGIS_REQUIRE_NATIVE=1 bun test tests/",
		"coverage": "QGIS_REQUIRE_NATIVE=1 bun test --coverage tests/contract.test.js",
		"pack:check": "cargo run -q -p xtask --manifest-path ../../Cargo.toml -- pack-check ts-packages/qgis-node src/index.js src/index.d.ts README.md bin/ 'qgis-node.*.node'",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write .",
		"prepublishOnly": "napi prepublish -t npm",
		"artifacts": "napi artifacts",
		"version": "napi version",
		"build:cli": "node scripts/stage-cli.js"
	},
	"keywords": [
		"qgis",
		"gis",
		"rendering",
		"tiles",
		"rust",
		"napi",
		"cli",
		"typescript"
	],
	"author": "qgis-rs contributors",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/Archont561/qgis-rs"
	},
	"bugs": {
		"url": "https://github.com/Archont561/qgis-rs/issues"
	},
	"homepage": "https://archont561.github.io/qgis-rs/",
	"napi": {
		"name": "qgis-node",
		"triples": {
			"defaults": false,
			"additional": [
				"x86_64-unknown-linux-gnu",
				"aarch64-unknown-linux-gnu",
				"x86_64-unknown-linux-musl"
			]
		},
		"binaryName": "qgis-node"
	},
	"devDependencies": {
		"@napi-rs/cli": "^2.18",
		"@types/bun": "latest",
		"fast-check": "^4.10.2",
		"typescript": "^5.0"
	},
	"dependencies": {},
	"engines": {
		"node": ">= 18"
	},
	"files": [
		"src/",
		"qgis-node.*.node",
		"bin/",
		"README.md"
	],
	"optionalDependencies": {
		"@archont561/qgis-node-linux-x64-gnu": "0.1.0",
		"@archont561/qgis-node-linux-arm64-gnu": "0.1.0",
		"@archont561/qgis-node-linux-x64-musl": "0.1.0"
	}
}
