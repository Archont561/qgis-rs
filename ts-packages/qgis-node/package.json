{
  "name": "qgis-rs",
  "version": "0.1.0",
  "description": "Node.js / TypeScript bindings and CLI for qgis-rs \u2014 native-speed QGIS rendering, tiling, and plugin tools",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "qgis-cli": "./bin/qgis-cli.js",
    "qgis-plugin": "./bin/qgis-plugin.js",
    "qgis-sdk": "./bin/qgis-sdk.js"
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../../crates/qgis-node/Cargo.toml -o .",
    "build:debug": "napi build --platform --manifest-path ../../crates/qgis-node/Cargo.toml -o .",
    "test": "node --test \"tests/**/*.test.js\"",
    "prepublishOnly": "napi prepublish -t npm --manifest-path ../../crates/qgis-node/Cargo.toml",
    "artifacts": "napi artifacts --manifest-path ../../crates/qgis-node/Cargo.toml",
    "version": "napi version --manifest-path ../../crates/qgis-node/Cargo.toml"
  },
  "keywords": [
    "qgis",
    "gis",
    "rendering",
    "tiles",
    "rust",
    "napi",
    "cli",
    "typescript"
  ],
  "author": "qgis-rs contributors",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archont561/qgis-rs"
  },
  "bugs": {
    "url": "https://github.com/Archont561/qgis-rs/issues"
  },
  "homepage": "https://archont561.github.io/qgis-rs/",
  "napi": {
    "name": "qgis-rs",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    },
    "binaryName": "qgis-rs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18",
    "@types/node": "^20.0",
    "typescript": "^5.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "qgis-rs.*.node",
    "bin/",
    "README.md"
  ]
}
