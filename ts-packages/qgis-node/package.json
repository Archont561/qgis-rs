{
	"name": "qgis-rs",
	"version": "0.1.0",
	"description": "Node.js / TypeScript bindings and CLI for qgis-rs \u2014 native-speed QGIS rendering, tiling, and plugin tools",
	"main": "index.js",
	"types": "index.d.ts",
	"bin": {
		"qgis-cli": "./bin/qgis-cli.js",
		"qgis-plugin": "./bin/qgis-plugin.js",
		"qgis-sdk": "./bin/qgis-sdk.js"
	},
	"scripts": {
		"build": "napi build --platform --release --cargo-cwd ../../crates/qgis-node --js false --dts .napi-generated.d.ts .",
		"build:debug": "napi build --platform --cargo-cwd ../../crates/qgis-node --js false --dts .napi-generated.d.ts .",
		"test": "QGIS_REQUIRE_NATIVE=1 bun test tests/contract.test.js",
		"coverage": "QGIS_REQUIRE_NATIVE=1 bun test --coverage tests/contract.test.js",
		"pack:check": "bash -c 'set -eu; fail=0; for f in index.js index.d.ts README.md; do [ -e \"$f\" ] || { echo \"missing from package: $f\" >&2; fail=1; }; done; [ -d bin ] || { echo \"missing from package: bin/\" >&2; fail=1; }; set -- qgis-rs.*.node; [ -e \"$1\" ] || { echo \"missing from package: qgis-rs.*.node (did napi build run?)\" >&2; fail=1; }; [ \"$fail\" = 0 ] || exit 1; echo \"package files present:\" index.js index.d.ts README.md bin/ \"$@\"'",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write .",
		"prepublishOnly": "napi prepublish -t npm",
		"artifacts": "napi artifacts",
		"version": "napi version"
	},
	"keywords": [
		"qgis",
		"gis",
		"rendering",
		"tiles",
		"rust",
		"napi",
		"cli",
		"typescript"
	],
	"author": "qgis-rs contributors",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/Archont561/qgis-rs"
	},
	"bugs": {
		"url": "https://github.com/Archont561/qgis-rs/issues"
	},
	"homepage": "https://archont561.github.io/qgis-rs/",
	"napi": {
		"name": "qgis-rs",
		"triples": {
			"defaults": false,
			"additional": [
				"x86_64-unknown-linux-gnu",
				"aarch64-unknown-linux-gnu",
				"x86_64-unknown-linux-musl"
			]
		},
		"binaryName": "qgis-rs"
	},
	"devDependencies": {
		"@napi-rs/cli": "^2.18",
		"@types/bun": "latest",
		"typescript": "^5.0"
	},
	"dependencies": {},
	"engines": {
		"node": ">= 18"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"qgis-rs.*.node",
		"bin/",
		"README.md"
	]
}
