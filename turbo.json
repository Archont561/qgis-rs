{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "*.node"],
			"inputs": [
				"src/**",
				"bunup.config.ts",
				"package.json",
				"tsconfig.json",
				"tsconfig.*.json",
				"../../tsconfig.base.json"
			]
		},
		"test": {
			"dependsOn": ["build", "^build"],
			"outputs": [],
			"inputs": [
				"src/**",
				"tests/**",
				"bin/**",
				"package.json",
				"tsconfig.json",
				"tsconfig.*.json",
				"../../tsconfig.base.json"
			]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": [
				"src/**",
				"tests/**",
				"package.json",
				"tsconfig.json",
				"tsconfig.*.json",
				"../../tsconfig.base.json"
			]
		},
		"lint": {
			"outputs": []
		},
		"coverage": {
			"dependsOn": ["build"],
			"outputs": [],
			"cache": false
		},
		"pack:check": {
			"dependsOn": ["build"],
			"outputs": []
		},
		"format": {
			"outputs": [],
			"cache": false
		},
		"//#lint": {
			"outputs": []
		},
		"//#format": {
			"outputs": [],
			"cache": false
		},
		"develop": {
			"cache": false,
			"persistent": false
		},
		"@archont561/qgis-node#build": {
			"inputs": [
				"index.js",
				"index.d.ts",
				"bin/**",
				"package.json",
				"../../crates/qgis-node/**",
				"../../crates/qgis-render/**",
				"../../crates/qgis-server/**",
				"../../crates/qgis-styles/**",
				"../../crates/qgis-cli/**",
				"../../Cargo.toml",
				"../../Cargo.lock"
			],
			"outputs": ["qgis-node.*.node", ".napi-generated.d.ts"]
		},
		"@archont561/qgis-node#test": {
			"inputs": [
				"index.js",
				"bin/**",
				"tests/**",
				"package.json",
				"../../crates/qgis-node/**",
				"../../crates/qgis-render/**",
				"../../crates/qgis-server/**",
				"../../crates/qgis-styles/**"
			],
			"dependsOn": ["build"]
		},
		"qgis-py-dist#build": {
			"inputs": [
				"pyproject.toml",
				"python/**",
				"tests/**",
				"../../crates/qgis-py/**",
				"../../crates/qgis-render/**",
				"../../Cargo.toml",
				"../../Cargo.lock"
			],
			"outputs": ["dist/**"],
			"cache": false
		},
		"qgis-sdk-py#build": {
			"inputs": [
				"pyproject.toml",
				"src/**",
				"tests/**",
				"scripts/**",
				"../../crates/qgis-sdk/**",
				"../../Cargo.toml",
				"../../Cargo.lock"
			],
			"outputs": ["dist/**"],
			"cache": false
		},
		"@qgis/rust#build": {
			"cache": false
		},
		"@qgis/rust#test": {
			"cache": false
		},
		"@qgis/rust#lint": {
			"cache": false
		},
		"@qgis/rust#format": {
			"cache": false
		},
		"qgis-py-dist#test": {
			"dependsOn": ["build"],
			"cache": false
		},
		"qgis-sdk-py#test": {
			"dependsOn": ["build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
