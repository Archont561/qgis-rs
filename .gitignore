# general
.*
_*

# …but Python packages need their underscore-prefixed modules committed,
# otherwise hatchling (which honours VCS ignore files) drops them from wheels.
!__init__.py
!__init__.pyi
!__main__.py
!_fallback.py
!_fallback_cli.py
!_core.pyi
!_core.py
!_native.py

# git / github
!.git*

# knowledge bundle
!.knowledge/

# pixi
!.pixi/config.toml

# cargo
/target
!.cargo

# cpp
!.clang*
compile_commands.json
symbology-style.db

# pixi-sandbox
.pixi-sandbox/
dist/

# docs app (Node.js / Astro)
apps/docs/node_modules/
# The Bun workspace at the root owns JS resolution; a root npm lock is a mistake
# (member locks, e.g. ts-packages/qgis-node/package-lock.json, stay tracked).
/package-lock.json
apps/docs/dist/
apps/docs/.astro/

# bun / node / napi — every JS package lives in ts-packages/
node_modules/
ts-packages/*/dist/
apps/*/node_modules/
apps/*/dist/
apps/docs/.astro/
# the compiled addon napi build drops next to the package.json
ts-packages/qgis-node/*.node

# python — wheels and editable installs built from py-packages/<name>
py-packages/*/*.egg-info/
py-packages/*/.pytest_cache/
