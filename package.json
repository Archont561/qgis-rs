{
	"name": "qgis-rs",
	"private": true,
	"version": "0.2.0",
	"description": "QGIS SDK \u2014 Python + Rust + Bun JS bridge with complete QGIS Web API",
	"workspaces": [
		"ts-packages/*",
		"apps/*",
		"crates",
		"py-packages/*"
	],
	"scripts": {
		"build": "bun run --filter './apps/*' --filter './ts-packages/*' build",
		"build:all": "bun x turbo run build",
		"test": "bun test",
		"test:py": "pytest py-packages/qgis-sdk/tests -v",
		"dev": "bun --bun astro dev --filter docs",
		"lint": "bunx biome check package.json turbo.json biome.json",
		"format": "bunx biome format --write package.json turbo.json biome.json",
		"docs:dev": "bun --cwd apps/docs dev",
		"docs:build": "bun --cwd apps/docs build"
	},
	"packageManager": "bun@1.3.11",
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest",
		"backlog.md": "^1.53.0",
		"skills": "^1.7.0",
		"turbo": "^2",
		"typescript": "^5.4.5"
	},
	"overrides": {
		"@astrojs/sitemap": "3.6.0"
	}
}
